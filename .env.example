# Discord Bot Configuration
# Obtain your Bot Token and Client ID from https://discord.com/developers/applications
DISCORD_BOT_TOKEN=your_discord_bot_token_here
DISCORD_CLIENT_ID=your_discord_application_client_id_here

# Optional: Specify your Discord Server / Guild ID for instant slash command registration in development
# Leaving this blank will register global slash commands (which can take up to 1 hour to propagate)
DISCORD_GUILD_ID=

# Polling Interval in minutes (Default: 2 minutes)
DEFAULT_POLL_INTERVAL_MINUTES=2

# Vancouver Default Postal Code prefix for In-Store pickup checks (e.g., V6B, V5H)
VANCOUVER_POSTAL_CODE=V6B

# SQLite Database File Path (Default: ./data/pokemon_stock.sqlite)
DATABASE_PATH=./data/pokemon_stock.sqlite

# Log Level (debug, info, warn, error)
LOG_LEVEL=info
